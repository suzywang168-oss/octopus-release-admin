name = "octopus-release-api"
main = "src/index.js"
compatibility_date = "2026-07-31"
workers_dev = true

[vars]
ALLOWED_ORIGINS = "https://suzywang168-oss.github.io,http://localhost:8787,http://127.0.0.1:5500"
ALLOW_DEMO = "true"

[[d1_databases]]
binding = "DB"
database_name = "octopus-release-db"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "migrations"
